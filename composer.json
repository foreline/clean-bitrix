{
  "name": "foreline/clean-bitrix",
  "description": "Implementation of foreline/clean PHP framework for 1C-Bitrix CMS",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Simakin Dima",
      "email": "dima@foreline.ru"
    }
  ],
  "require": {
    "php": ">=8.1",
    "foreline/clean": "^3.3.1",
    "foreline/clean-ui": "^1.1.0",
    "foreline/io-response": "*",
    "symfony/http-foundation": ">6.3",
    "ext-curl": "*",
    "predis/predis": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "*",
    "jetbrains/phpstorm-attributes": "*"
  },
  "autoload": {
    "psr-4": {
      "Domain\\": "src/Domain",
      "Infrastructure\\": "src/Infrastructure",
      "Presentation\\": "src/Presentation"
    }
  },
  "repositories": [
    {
      "type": "git",
      "url": "git@github.com:foreline/clean.git"
    },
    {
      "type": "git",
      "url": "git@github.com:foreline/clean-ui.git"
    },
    {
      "type": "git",
      "url": "git@github.com:foreline/io-response.git"
    }
  ]
}
