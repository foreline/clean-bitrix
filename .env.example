APP_ENV=test
#
EXCEPTION_TELEGRAM_TOKEN=
EXCEPTION_TELEGRAM_CHAT_ID=
ERROR_TELEGRAM_TOKEN=${EXCEPTION_TELEGRAM_TOKEN}
ERROR_TELEGRAM_CHAT_ID=${EXCEPTION_TELEGRAM_CHAT_ID}
WARNING_TELEGRAM_TOKEN=${EXCEPTION_TELEGRAM_TOKEN}
WARNING_TELEGRAM_CHAT_ID=${EXCEPTION_TELEGRAM_CHAT_ID}
#
EXCEPTION_EMAIL=
ERROR_EMAIL=${EXCEPTION_EMAIL}
WARNING_EMAIL=${EXCEPTION_EMAIL}
TESTS_EMAIL=${EXCEPTION_EMAIL}

# ASYNC EVENTS
# Enable async event dispatch for AsyncSubscriberInterface subscribers [Y|N]
ASYNC_EVENTS_ENABLED=N
# Messenger transport DSN [database://default | redis://127.0.0.1:6379/messages | in-memory://]
MESSENGER_TRANSPORT_DSN=database://default
# Retry policy for failed async dispatches
# Max retries: 0 = unlimited, >0 = give up after N attempts
MESSENGER_RETRY_MAX_RETRIES=0
# Base delay in ms before first retry (default: 60s)
MESSENGER_RETRY_BASE_DELAY_MS=60000
# Exponential backoff multiplier (default: 2.0)
MESSENGER_RETRY_MULTIPLIER=2.0
# Maximum delay cap in ms (default: 1 hour)
MESSENGER_RETRY_MAX_DELAY_MS=3600000
# Random jitter in ms to prevent thundering herd (default: 30s)
MESSENGER_RETRY_JITTER_MS=30000
# Event store auto-purge strategy after all dispatches complete
# Options: immediate (delete right away) | retention (keep for batch purge) | none (keep forever)
EVENT_STORE_PURGE_STRATEGY=immediate